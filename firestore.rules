rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is a player in a game
    function isPlayerInGame(gameId) {
      let game = get(/databases/$(database)/documents/games/$(gameId)).data;
      return game.players != null && 
        (game.players.hasAny([request.auth.uid]) || 
         game.players.hasAny([{'id': request.auth.uid}]));
    }

    // Helper function to check if user has an approved join request
    function hasApprovedRequest(gameId) {
      let requestPath = /databases/$(database)/documents/joinRequests/$(request.auth.uid + '-' + gameId);
      let request = exists(requestPath) ? get(requestPath).data : null;
      return request != null && request.status == 'approved';
    }

    // Games collection
    match /games/{gameId} {
      // Allow read if user is authenticated
      allow read: if isAuthenticated();
      
      // Allow write if user is authenticated and is a player in the game
      allow write: if isAuthenticated() && isPlayerInGame(gameId);

      // Allow access to subcollections if user is a player
      match /{document=**} {
        allow read, write: if isAuthenticated() && isPlayerInGame(gameId);
      }
    }

    // Weekly moves collection
    match /weeklyMoves/{moveId} {
      // Allow read/write if user is authenticated and is a player in the game
      allow read, write: if isAuthenticated();
    }

    // Players collection
    match /players/{playerId} {
      // Allow read if user is authenticated
      allow read: if isAuthenticated();
      
      // Allow write if user is authenticated and is the player
      allow write: if isAuthenticated() && request.auth.uid == playerId;
    }

    // Join requests collection
    match /joinRequests/{requestId} {
      // Allow read if user is authenticated and is the requester
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
      );
      
      // Allow create if user is authenticated
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid
      );
    }
  }
}
